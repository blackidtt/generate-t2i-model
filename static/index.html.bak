<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Eksperimen Revisi Prompt</title>
<style>
  :root{--bg:#f5f7fb;--card:#fff;--ink:#0b1f3a;--muted:#5b6b82;--line:#d9e2ec;--brand:#2b4c7e;--accent:#0f8b8d;--warn:#b5543c}
  *{box-sizing:border-box}
  body{margin:0;font-family:Calibri,Arial,sans-serif;background:var(--bg);color:var(--ink);line-height:1.45}
  header{background:var(--ink);color:#fff;padding:12px 24px;display:flex;justify-content:space-between;align-items:center}
  header h1{font-size:18px;margin:0}
  header .pid{font-size:13px;opacity:.8}
  main{max-width:1100px;margin:24px auto;padding:0 16px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:20px 24px;margin-bottom:16px}
  h2{margin:0 0 8px;font-size:22px}
  p{margin:8px 0}
  .muted{color:var(--muted);font-size:14px}
  input[type=text],textarea{width:100%;font:inherit;padding:10px 12px;border:1px solid var(--line);border-radius:8px;background:#fff}
  textarea{min-height:96px;resize:vertical}
  button{font:inherit;font-weight:600;border:0;border-radius:8px;padding:10px 18px;cursor:pointer;background:var(--brand);color:#fff}
  button.secondary{background:#fff;color:var(--brand);border:1px solid var(--brand)}
  button.link{background:none;color:var(--muted);text-decoration:underline;padding:6px;font-weight:400}
  button:disabled{opacity:.45;cursor:not-allowed}
  .row{display:flex;gap:20px;flex-wrap:wrap}
  .col{flex:1 1 360px;min-width:0}
  .imgbox{aspect-ratio:1/1;max-width:512px;background:#eef2f7;border:1px dashed var(--line);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--muted);overflow:hidden;position:relative}
  .imgbox img{width:100%;height:100%;object-fit:contain;display:block}
  .imgbox .spin{position:absolute;inset:0;background:rgba(255,255,255,.75);display:none;align-items:center;justify-content:center;font-weight:600}
  .imgbox.busy .spin{display:flex}
  .label{font-weight:700;margin:0 0 6px;font-size:14px;color:var(--brand);text-transform:uppercase;letter-spacing:.04em}
  .warn{background:#fdf0ec;border:1px solid #f0c9bd;color:var(--warn);padding:8px 12px;border-radius:8px;margin:10px 0;font-size:14px;display:none}
  .ok{background:#e8f5f1;border:1px solid #b9ded4;color:#0b5d57;padding:10px 14px;border-radius:8px;margin:10px 0;display:none}
  .chat{border:1px solid var(--line);border-radius:8px;background:#fafcff;padding:10px;max-height:200px;overflow:auto;margin-bottom:10px;font-size:15px}
  .bubble{padding:6px 10px;border-radius:12px;margin:4px 0;max-width:85%}
  .me{background:var(--brand);color:#fff;margin-left:auto}
  .sys{background:#e6eef7}
  .actions{display:flex;gap:10px;align-items:center;margin-top:10px;flex-wrap:wrap}
  .hidden{display:none!important}
  ul.rules{margin:8px 0 8px 20px;padding:0}
  .mockbar{background:#e9b44c;color:#0b1f3a;text-align:center;padding:4px;font-size:13px;font-weight:600}
</style>
</head>
<body>
<div id="mockbar" class="mockbar hidden">MODE MOCK: gambar dan skor tiruan, bukan SDXL-Turbo dan CLIP</div>
<header><h1>Eksperimen Revisi Prompt Text-to-Image</h1><div class="pid" id="pidlabel"></div></header>
<main>

<section id="s-register" class="card hidden">
  <h2>Mulai sesi</h2>
  <p class="muted">Masukkan kode partisipan dari peneliti.</p>
  <p><input type="text" id="pid-input" placeholder="contoh: P01" maxlength="32" autocomplete="off"></p>
  <div class="actions"><button id="btn-register">Lanjut</button></div>
  <div id="reg-err" class="warn"></div>
</section>

<section id="s-consent" class="card hidden">
  <h2>Persetujuan partisipasi</h2>
  <p>Anda diminta membuat ulang sebuah gambar target dengan menulis dan merevisi prompt pada dua cara kerja yang berbeda. Sesi berlangsung sekitar 20 sampai 40 menit.</p>
  <ul class="rules">
    <li>Data yang dicatat: teks yang Anda ketik, waktu, dan gambar yang dihasilkan. Tidak ada data pribadi, hanya kode partisipan.</li>
    <li>Anda boleh berhenti kapan saja tanpa konsekuensi.</li>
    <li><b>Tulis semua prompt dan instruksi dalam bahasa Inggris.</b> Model gambar hanya didukung secara resmi untuk bahasa Inggris. Jangan memakai alat bantu eksternal, termasuk alat terjemahan.</li>
  </ul>
  <p><label><input type="checkbox" id="consent-check"> Saya sudah membaca penjelasan di atas dan setuju berpartisipasi.</label></p>
  <div class="actions"><button id="btn-consent" disabled>Mulai</button></div>
</section>

<section id="s-work" class="hidden">
  <div class="card">
    <h2 id="work-title"></h2>
    <p id="work-desc" class="muted"></p>
    <div id="lang-warn" class="warn">Teks Anda terdeteksi bukan bahasa Inggris. Mohon tulis dalam bahasa Inggris.</div>
  </div>
  <div class="row">
    <div class="col" id="col-target">
      <div class="card">
        <p class="label">Gambar target</p>
        <div class="imgbox"><img id="target-img" alt="Gambar target"></div>
      </div>
    </div>
    <div class="col">
      <div class="card">
        <p class="label">Gambar Anda</p>
        <div class="imgbox" id="result-box"><span id="result-ph">Belum ada gambar</span><img id="result-img" class="hidden" alt="Hasil"><div class="spin">Membuat gambar...</div></div>

        <div id="ipe-ui" class="hidden" style="margin-top:14px">
          <p class="label">Prompt</p>
          <textarea id="ipe-text" placeholder="Describe the image in English"></textarea>
          <div class="actions"><button id="btn-ipe">Generate</button></div>
        </div>

        <div id="cfu-first" class="hidden" style="margin-top:14px">
          <p class="label">Prompt awal</p>
          <textarea id="cfu-first-text" placeholder="Describe the image in English"></textarea>
          <div class="actions"><button id="btn-cfu-first">Generate</button></div>
        </div>

        <div id="cfu-chat-ui" class="hidden" style="margin-top:14px">
          <p class="label">Percakapan</p>
          <div class="chat" id="chat"></div>
          <input type="text" id="cfu-text" placeholder="Tell the assistant what to change, in English">
          <div class="actions"><button id="btn-cfu">Kirim</button></div>
        </div>

        <div id="score-debug" class="muted hidden" style="margin-top:8px">Skor (debug peneliti): <b id="score-val"></b></div>
        <div id="done-ok" class="ok">Gambar Anda sudah sesuai dengan target.</div>
        <div id="err" class="warn"></div>
        <div class="actions">
          <button id="btn-next" class="hidden">Lanjut</button>
          <button id="btn-giveup" class="link hidden">Saya ingin berhenti pada tugas ini</button>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="s-break" class="card hidden">
  <h2>Istirahat sebentar</h2>
  <p>Tugas pertama selesai. Tugas kedua memakai gambar target yang sama dengan cara kerja yang berbeda. Tekan lanjut saat siap.</p>
  <div class="actions"><button id="btn-break">Lanjut ke tugas kedua</button></div>
</section>

<section id="s-done" class="card hidden">
  <h2>Terima kasih</h2>
  <p>Sesi Anda sudah selesai. Data Anda tersimpan dengan kode partisipan saja.</p>
</section>

</main>
<div style="text-align:center;margin:20px"><button class="link" id="btn-reset">Ganti partisipan</button></div>

<script>
const $ = id => document.getElementById(id);
const S = {pid:null, stage:null, mode:null, n:0, phase:'first', busy:false};
const SCREENS = ['s-register','s-consent','s-work','s-break','s-done'];

async function api(path, body){
  const opt = body ? {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)} : {};
  const r = await fetch(path, opt);
  const j = await r.json().catch(()=>({}));
  if(!r.ok) throw new Error(j.error || 'Terjadi kesalahan ('+r.status+')');
  return j;
}
function show(id){ SCREENS.forEach(s=>$(s).classList.toggle('hidden', s!==id)); }
function setErr(msg){ const e=$('err'); e.textContent=msg||''; e.style.display=msg?'block':'none'; }
function setBusy(b){
  S.busy=b; $('result-box').classList.toggle('busy',b);
  ['btn-ipe','btn-cfu-first','btn-cfu','btn-giveup'].forEach(i=>$(i).disabled=b);
}
function setImage(uri){ $('result-img').src=uri; $('result-img').classList.remove('hidden'); $('result-ph').classList.add('hidden'); }
function langWarn(flag){ $('lang-warn').style.display = flag ? 'block':'none'; }
function addBubble(text, me){
  const d=document.createElement('div'); d.className='bubble '+(me?'me':'sys'); d.textContent=text;
  $('chat').appendChild(d); $('chat').scrollTop=$('chat').scrollHeight;
}

async function route(st){
  S.pid=st.pid; S.stage=st.stage; S.mode=st.mode; localStorage.setItem('pid', st.pid);
  $('pidlabel').textContent = 'Kode: '+st.pid;
  if(st.stage==='consent') return show('s-consent');
  if(st.stage==='break') return show('s-break');
  if(st.stage==='done') return show('s-done');
  if(st.stage.startsWith('practice')) return openWork(true, st);
  if(st.stage.startsWith('task')) return openWork(false, st);
}

function resetWork(){
  S.n=0; S.phase='first'; setErr(''); langWarn(false);
  $('result-img').classList.add('hidden'); $('result-ph').classList.remove('hidden');
  $('chat').innerHTML=''; $('ipe-text').value=''; $('cfu-first-text').value=''; $('cfu-text').value='';
  $('done-ok').style.display='none'; $('btn-next').disabled=false; $('btn-next').classList.add('hidden'); $('btn-giveup').classList.add('hidden');
  ['ipe-ui','cfu-first','cfu-chat-ui'].forEach(i=>$(i).classList.add('hidden'));
}

async function openWork(practice, st){
  resetWork(); show('s-work');
  S.practice = practice;
  $('col-target').classList.toggle('hidden', practice);
  const modeName = S.mode==='IPE' ? 'Mengedit prompt langsung' : 'Instruksi lanjutan lewat percakapan';
  const stepNo = st.stage.slice(-1);
  if(practice){
    $('work-title').textContent = 'Latihan '+stepNo+' dari 2: '+modeName;
    $('work-desc').textContent = S.mode==='IPE'
      ? 'Tulis sebuah deskripsi gambar dalam bahasa Inggris (misalnya "a cat on a sofa"), tekan Generate, lalu ubah teks prompt dan Generate lagi. Latihan ini tidak dinilai.'
      : 'Tulis deskripsi gambar dalam bahasa Inggris, tekan Generate, lalu sampaikan perubahan yang diinginkan lewat kotak percakapan. Latihan ini tidak dinilai.';
    $('btn-next').textContent='Selesai latihan'; $('btn-next').disabled=true; $('btn-next').classList.remove('hidden');
    prepareInputs();
  } else {
    $('work-title').textContent = 'Tugas '+stepNo+' dari 2: '+modeName;
    $('work-desc').textContent = 'Buat ulang gambar target di sebelah kiri semirip mungkin. Tulis semua teks dalam bahasa Inggris. Lanjutkan merevisi sampai sistem menyatakan gambar sudah sesuai.';
    try{
      const t = await api('/api/task/start', {pid:S.pid});
      $('target-img').src = t.target_url+'?t='+Date.now();
      S.n = t.n_iter;
      if(t.done){ finishTask(); return; }
      prepareInputs();
      if(t.last_image){ setImage(t.last_image); if(t.prompt) $('ipe-text').value=t.prompt; }
      $('btn-giveup').classList.remove('hidden');
    }catch(e){ setErr(e.message); }
  }
}

function prepareInputs(){
  if(S.mode==='IPE'){ $('ipe-ui').classList.remove('hidden'); }
  else if(S.n===0){ $('cfu-first').classList.remove('hidden'); }
  else { $('cfu-chat-ui').classList.remove('hidden'); }
}

async function doStep(text){
  if(S.busy) return;
  setErr(''); setBusy(true);
  try{
    const r = await api(S.practice ? '/api/practice/step' : '/api/task/step', {pid:S.pid, text});
    if(r.score!=null){ $('score-debug').classList.remove('hidden'); $('score-val').textContent=r.score+' ('+r.gen_s+' detik)'; }
    setImage(r.image); S.n = S.practice ? r.n : S.n+1; langWarn(r.non_english);
    if(S.mode==='IPE' && r.prompt!=null) $('ipe-text').value = r.prompt;
    if(S.mode==='CFU'){
      if($('cfu-chat-ui').classList.contains('hidden')){ $('cfu-first').classList.add('hidden'); $('cfu-chat-ui').classList.remove('hidden'); addBubble('Gambar pertama dibuat dari prompt Anda.', false); }
      else { addBubble(text, true); addBubble(r.llm_error ? 'Asisten tidak dapat memproses instruksi. Coba kalimat lain.' : 'Gambar diperbarui.', false); }
      $('cfu-text').value='';
    }
    if(S.practice) $('btn-next').disabled=false;
    else if(r.done){ finishTask(); }
  }catch(e){ setErr(e.message); }
  finally{ setBusy(false); }
}

function finishTask(){
  $('done-ok').style.display='block'; $('btn-next').textContent='Lanjut'; $('btn-next').classList.remove('hidden');
  $('btn-giveup').classList.add('hidden');
  ['ipe-ui','cfu-first','cfu-chat-ui'].forEach(i=>$(i).classList.add('hidden'));
}

$('btn-register').onclick = async ()=>{
  const pid=$('pid-input').value.trim(); $('reg-err').style.display='none';
  const order=new URLSearchParams(location.search).get('order');
  try{ route(await api('/api/register', {pid, order})); }
  catch(e){ $('reg-err').textContent=e.message; $('reg-err').style.display='block'; }
};
$('consent-check').onchange = e=>{ $('btn-consent').disabled=!e.target.checked; };
$('btn-consent').onclick = async ()=>{ route(await api('/api/advance', {pid:S.pid, from_stage:'consent'})); };
$('btn-break').onclick = async ()=>{ route(await api('/api/advance', {pid:S.pid, from_stage:'break'})); };
$('btn-ipe').onclick = ()=>doStep($('ipe-text').value);
$('btn-cfu-first').onclick = ()=>doStep($('cfu-first-text').value);
$('btn-cfu').onclick = ()=>doStep($('cfu-text').value);
$('cfu-text').addEventListener('keydown', e=>{ if(e.key==='Enter') doStep($('cfu-text').value); });
$('btn-next').onclick = async ()=>{ try{ route(await api('/api/advance', {pid:S.pid, from_stage:S.stage})); }catch(e){ setErr(e.message); } };
$('btn-giveup').onclick = async ()=>{
  if(!confirm('Yakin ingin berhenti pada tugas ini? Tugas tidak bisa dilanjutkan lagi.')) return;
  try{ await api('/api/task/giveup', {pid:S.pid}); finishTask(); $('done-ok').style.display='none'; }catch(e){ setErr(e.message); }
};
$('btn-reset').onclick = ()=>{ localStorage.removeItem('pid'); location.reload(); };

(async function init(){
  try{ const c=await api('/api/config'); $('mockbar').classList.toggle('hidden', !c.mock); }catch(e){}
  const pid = localStorage.getItem('pid');
  if(pid){ try{ return route(await api('/api/state?pid='+encodeURIComponent(pid))); }catch(e){ localStorage.removeItem('pid'); } }
  show('s-register');
})();
</script>
</body>
</html>
